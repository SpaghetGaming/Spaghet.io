---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { WORK } from "@consts"
import { getWorkExperiences, type WorkExperience } from "@lib/appwrite-service"

type Props = {
  entry: WorkExperience
}

const work = await getWorkExperiences()
  .then(workList => {
    return workList;
  })
  .catch(error => {
    console.error("Error fetching work experiences:", error);
    return [];
  })

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") input = new Date(input)

  const month = input.toLocaleDateString("en-US", {
    month: "short",
  })

  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {WORK.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <ul>
      { 
        work.sort((a, b) => a.dateEnd > b.dateEnd ? -1 : b.dateEnd > a.dateEnd ? 1 : 0).map((entry) => (
          <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-sm uppercase mb-4">
              {formatWorkDate(entry.dateStart)} - {formatWorkDate(entry.dateEnd)}
            </div>
            <div class="text-spaghetti-brown/100 dark:text-spaghetti-yellow font-semibold">
              {entry.company}
            </div>
            <div class="text-sm font-semibold text-spaghetti-brown/100 dark:text-spaghetti-yellow">
              {entry.role}
            </div>
            <article class="prose dark:prose-invert text-spaghetti-brown/100 dark:text-spaghetti-cream" set:html={entry.contentHtml}></article>
          </li>
        ))
      }
    </ul>

  </BottomLayout>
</PageLayout>
