---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { WORK } from "@consts"
import { getWorkExperiences } from "@lib/appwrite-service"

// Helper function to map Appwrite document to compatible format for work page
function mapAppwriteWorkToEntry(work: any) {
  return {
    id: work.$id,
    slug: work.$id, // Using ID as slug since we don't have a proper slug field
    data: {
      company: work.company,
      role: work.role,
      dateStart: new Date(work.dateStart),
      dateEnd: work.dateEnd,
      content: work.content // This will be rendered in the component
    },
    body: work.content
  };
}

const work = await getWorkExperiences()
  .then(workList => {
    return workList.map(mapAppwriteWorkToEntry);
  })
  .catch(error => {
    console.error("Error fetching work experiences:", error);
    return [];
  })

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input

  const month = input.toLocaleDateString("en-US", {
    month: "short",
  })

  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {WORK.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <ul>
      { 
        work.map((entry) => (
          <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-sm uppercase mb-4">
              {formatWorkDate(entry.data.dateStart)} - {formatWorkDate(entry.data.dateEnd)}
            </div>
            <div class="text-black dark:text-white font-semibold">
              {entry.data.company}
            </div>
            <div class="text-sm font-semibold">
              {entry.data.role}
            </div>
            <article class="prose dark:prose-invert">
              {entry.body}
            </article>
          </li>
        ))
      }
    </ul>

  </BottomLayout>
</PageLayout>
