---
/**
 * NoodleTwinklingStars.astro
 * This component creates twinkling noodles that are appended to the galaxy on interval.
 * Twinkling noodles are removed from the document after the animation is completed.
 * The svg below is just a template for the script to clone and append to the galaxy.
 */
---

<svg 
  id="noodle" 
  class="template" 
  width="149" 
  height="149" 
  viewBox="0 0 149 149" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg"
  class="absolute left-full animate-twinkle"
>
  <circle cx="74" cy="74" r="11" fill="#FF6B6B"/>
  <rect y="141.421" width="200" height="10" transform="rotate(-45 0 141.421)" fill="url(#paint0_linear_4_2)"/>
  <rect x="7.07107" width="200" height="10" transform="rotate(45 7.07107 0)" fill="url(#paint1_linear_4_2)"/>
  <defs>
    <linearGradient id="paint0_linear_4_2" x1="0" y1="146.421" x2="200" y2="146.421" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FF6B6B"/>
      <stop offset="0.445" stop-color="white"/>
      <stop offset="0.58721" stop-color="white"/>
      <stop offset="1" stop-color="#FF6B6B"/>
    </linearGradient>
    <linearGradient id="paint1_linear_4_2" x1="7.07107" y1="5" x2="207.071" y2="5" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FF6B6B"/>
      <stop offset="0.42" stop-color="white"/>
      <stop offset="0.555" stop-color="white"/>
      <stop offset="1" stop-color="#FF6B6B"/>
    </linearGradient>
  </defs>
</svg>

<script is:inline>
  // Generate a twinkling noodle and append it to the galaxy, remove it after animation.
  function generateNoodle() {
    const noodleTemplate = document.getElementById("noodle")
    if (!noodleTemplate) { return; }
    // Clone the noodle template and set its attributes.
    const noodle = noodleTemplate.cloneNode(true);
    noodle.style.position = "absolute";
    noodle.style.left = Math.floor(Math.random() * window.innerWidth) + "px";
    noodle.style.top = Math.floor(Math.random() * (window.innerHeight/3)) + "px";
    noodle.style.width = window.innerWidth < 768 ? Math.floor(Math.random() * (15 - 7.5 + 1) + 7.5) : Math.floor(Math.random() * (30 - 15 + 1) + 15) + "px";
    noodle.style.height = noodle.style.width;
    noodle.classList.add("twinkle");
    document.getElementById("galaxy").appendChild(noodle);

    // Remove the twinkling noodle after the animation is completed.
    setTimeout(() => {
      noodle.remove();
    }, 2500);
  }

  setInterval(generateNoodle, 5000);
</script>
