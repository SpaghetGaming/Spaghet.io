{
  "name": "astro-sphere",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "dotenv -e .env -- astro dev",
    "dev:network": "dotenv -e .env -- astro dev --host",
    "start": "dotenv -e .env -- astro dev",
    "build": "astro check && astro build",
    "preview": "dotenv -e .env -- astro preview",
    "preview:network": "dotenv -e .env -- astro dev --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.5.6",
    "@astrojs/mdx": "^4.3.3",
    "@astrojs/node": "^9.4.1",
    "@astrojs/rss": "^4.0.5",
    "@astrojs/sitemap": "^3.5.0",
    "@astrojs/solid-js": "^5.1.0",
    "@astrojs/tailwind": "^6.0.2",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/typography": "^0.5.10",
    "astro": "^5.13.0",
    "clsx": "^2.1.0",
    "fuse.js": "^7.0.0",
    "notenv": "^2.0.3",
    "npm": "^11.5.2",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.33.2",
    "solid-js": "^1.8.15",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "appwrite": "^18.2.0",
    "dotenv-cli": "^10.0.0"
  }
}
